# LeagueUp frontend — copy to .env.local.

# Backend API base URL (leagueup_be mounts everything under /api/v1).
# API_URL is used by server code; NEXT_PUBLIC_API_URL is exposed to the browser.
API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Google Maps (browser key). Optional: without it, map features hide and manual address entry still works.
# In Google Cloud, restrict the key by HTTP referrer (http://localhost:3000/*, your domains) and to these APIs:
# Maps JavaScript API, Places API (New), Geocoding API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID with a dark style (Map Management). Leave empty to use DEMO_MAP_ID in development.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
